# Copy to .env (scripts and `make eval`) and to api/.dev.vars (the Worker under `wrangler dev`).
# Placeholder values only: put your own keys in the copies, never in this file. Both copies are git-ignored.

# Supabase: your own project (Settings > API). Local: `supabase start` prints the URL and the secret key.
BARTE_ACADEMY_SUPABASE_URL=http://127.0.0.1:54321
BARTE_ACADEMY_SUPABASE_SECRET_KEY=your-supabase-secret-key
BARTE_ACADEMY_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
# Only for scripts/kit_online_test.py, which skips without them.
BARTE_ACADEMY_SUPABASE_PROJECT_ID=your-project-ref
BARTE_ACADEMY_SUPABASE_ACCESS_TOKEN=your-supabase-personal-access-token

# Claude: your own Anthropic API key. Without it the Worker skips the Claude tasks and the rules decide alone.
BARTE_ACADEMY_ANTHROPIC_API_KEY=your-anthropic-api-key

# Cloudflare Access: leave empty locally and the Worker answers 401/503 outside /health.
# To log in locally, point them at an Access application of your own.
ACCESS_AUD=
ACCESS_TEAM_DOMAIN=your-team.cloudflareaccess.com

# Who approves and who administers, as JSON. Empty: nobody approves or administers (fail-closed).
APPROVER_LEVELS={"you@example.com":"diretoria"}
BARTE_ACADEMY_ADMIN_EMAILS=["you@example.com"]

# Optional: without it, supplier e-mails go to the mock outbox.
RESEND_API_KEY=
