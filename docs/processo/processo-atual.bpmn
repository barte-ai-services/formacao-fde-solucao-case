<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Defs_ContasAPagar_Atual" targetNamespace="https://barte.ai/formacao-fde/ja-chegou">
  <bpmn:collaboration id="Collab_ContasAPagar_Atual">
    <bpmn:participant id="Part_ContasAPagar_Atual" name="Já Chegou: contas a pagar hoje" processRef="ContasAPagar_Atual" />
  </bpmn:collaboration>
  <bpmn:process id="ContasAPagar_Atual" name="Contas a pagar da Já Chegou: processo atual" isExecutable="false">
    <bpmn:laneSet id="LaneSet_ContasAPagar_Atual">
      <bpmn:lane id="L_Compras" name="Compras">
        <bpmn:flowNodeRef>A_Inicio</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A_Pedido</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_Fornecedor" name="Fornecedor">
        <bpmn:flowNodeRef>A_Nota</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A_Divide</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A_Entrega</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_Doca" name="Doca (CD e lojas)">
        <bpmn:flowNodeRef>A_Recebe</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_Conferencia" name="Contas a pagar: conferência">
        <bpmn:flowNodeRef>A_Confere</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A_Diverge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A_Complementar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A_Conciliada</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A_Provisao</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_Lista" name="Contas a pagar: lista do dia">
        <bpmn:flowNodeRef>A_Lista</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_CFO" name="CFO">
        <bpmn:flowNodeRef>A_Aprova</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_Banco" name="Banco">
        <bpmn:flowNodeRef>A_Paga</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A_Pago</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="A_Inicio" name="Precisa comprar">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="A_Pedido" name="Emitir o pedido no ERP">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="A_Nota" name="Emitir a nota antes de entregar">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:parallelGateway id="A_Divide" name="">
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:task id="A_Entrega" name="Entregar a mercadoria">
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="A_Recebe" name="Receber a mercadoria">
      <bpmn:incoming>Flow_6</bpmn:incoming>
      <bpmn:outgoing>Flow_7</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="A_Confere" name="Conferir nota, pedido e recebido à mão">
      <bpmn:incoming>Flow_7</bpmn:incoming>
      <bpmn:outgoing>Flow_8</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="A_Diverge" name="Diverge?">
      <bpmn:incoming>Flow_8</bpmn:incoming>
      <bpmn:outgoing>Flow_9</bpmn:outgoing>
      <bpmn:outgoing>Flow_10</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="A_Complementar" name="Abrir ordem complementar ou provisionar">
      <bpmn:incoming>Flow_10</bpmn:incoming>
      <bpmn:outgoing>Flow_11</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="A_Conciliada" name="Nota conciliada">
      <bpmn:incoming>Flow_9</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="A_Provisao" name="Mês fecha com provisão">
      <bpmn:incoming>Flow_11</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="A_Lista" name="Montar a lista do dia (ERP, e-mail, WhatsApp)">
      <bpmn:incoming>Flow_5</bpmn:incoming>
      <bpmn:outgoing>Flow_12</bpmn:outgoing>
    </bpmn:task>
    <bpmn:userTask id="A_Aprova" name="Aprovar item a item, das 16h às 18h">
      <bpmn:incoming>Flow_12</bpmn:incoming>
      <bpmn:outgoing>Flow_13</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:task id="A_Paga" name="Pagar um boleto por vez">
      <bpmn:incoming>Flow_13</bpmn:incoming>
      <bpmn:outgoing>Flow_14</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="A_Pago" name="Pago, conferido ou não">
      <bpmn:incoming>Flow_14</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="A_Inicio" targetRef="A_Pedido" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="A_Pedido" targetRef="A_Nota" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="A_Nota" targetRef="A_Divide" />
    <bpmn:sequenceFlow id="Flow_4" sourceRef="A_Divide" targetRef="A_Entrega" />
    <bpmn:sequenceFlow id="Flow_5" sourceRef="A_Divide" targetRef="A_Lista" />
    <bpmn:sequenceFlow id="Flow_6" sourceRef="A_Entrega" targetRef="A_Recebe" />
    <bpmn:sequenceFlow id="Flow_7" sourceRef="A_Recebe" targetRef="A_Confere" />
    <bpmn:sequenceFlow id="Flow_8" sourceRef="A_Confere" targetRef="A_Diverge" />
    <bpmn:sequenceFlow id="Flow_9" name="não" sourceRef="A_Diverge" targetRef="A_Conciliada" />
    <bpmn:sequenceFlow id="Flow_10" name="sim" sourceRef="A_Diverge" targetRef="A_Complementar" />
    <bpmn:sequenceFlow id="Flow_11" sourceRef="A_Complementar" targetRef="A_Provisao" />
    <bpmn:sequenceFlow id="Flow_12" sourceRef="A_Lista" targetRef="A_Aprova" />
    <bpmn:sequenceFlow id="Flow_13" sourceRef="A_Aprova" targetRef="A_Paga" />
    <bpmn:sequenceFlow id="Flow_14" sourceRef="A_Paga" targetRef="A_Pago" />
    <bpmn:textAnnotation id="Note_1"><bpmn:text>Ninguém olhou a nota antes. Entra mesmo divergente, por pressão comercial.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Assoc_1" sourceRef="A_Recebe" targetRef="Note_1" />
    <bpmn:textAnnotation id="Note_2"><bpmn:text>Até 14 dias no CD. Só 0,7% das notas casam sozinhas.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Assoc_2" sourceRef="A_Confere" targetRef="Note_2" />
    <bpmn:textAnnotation id="Note_3"><bpmn:text>Pagar errado: R$ 543 mil por mês sem mercadoria, nada recuperado.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Assoc_3" sourceRef="A_Paga" targetRef="Note_3" />
  </bpmn:process>
