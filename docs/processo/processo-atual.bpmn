<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" id="Defs_AccountsPayable_Current" targetNamespace="https://barte.ai/formacao-fde/ja-chegou">
  <bpmn:collaboration id="Collab_AccountsPayable_Current">
    <bpmn:participant id="Part_AccountsPayable_Current" name="Já Chegou · contas a pagar hoje" processRef="AccountsPayable_Current" />
  </bpmn:collaboration>
  <bpmn:process id="AccountsPayable_Current" name="Contas a pagar da Já Chegou: processo atual" isExecutable="false">
    <bpmn:laneSet id="LaneSet_AccountsPayable_Current">
      <bpmn:lane id="Lane_Purchasing" name="Compras">
        <bpmn:flowNodeRef>Start_NeedToBuy</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_IssueOrder</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Supplier" name="Fornecedor">
        <bpmn:flowNodeRef>Task_IssueInvoice</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Deliver</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Dock" name="Doca (CD e lojas)">
        <bpmn:flowNodeRef>Task_Receive</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Matching" name="Conferência">
        <bpmn:flowNodeRef>Task_MatchByHand</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Differs</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Matched</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Supplement</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Provisioned</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_DailyList" name="Lista do dia">
        <bpmn:flowNodeRef>Task_BuildList</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_CFO" name="CFO">
        <bpmn:flowNodeRef>Task_ApproveAll</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Bank" name="Banco">
        <bpmn:flowNodeRef>Task_PayOneByOne</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Paid</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_NeedToBuy" name="Precisa comprar">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="Task_IssueOrder" name="Emitir o pedido no ERP">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_IssueInvoice" name="Emitir a nota antes de entregar">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:parallelGateway id="Gateway_Split" name="Dois caminhos sem integração">
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:task id="Task_Deliver" name="Entregar a mercadoria">
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
    </bpmn:task>
    <bpmn:userTask id="Task_Receive" name="Receber sem olhar a nota">
      <bpmn:incoming>Flow_6</bpmn:incoming>
      <bpmn:outgoing>Flow_7</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_MatchByHand" name="Conferir à mão, até 14 dias depois">
      <bpmn:incoming>Flow_7</bpmn:incoming>
      <bpmn:outgoing>Flow_8</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_Differs" name="Diverge?">
      <bpmn:incoming>Flow_8</bpmn:incoming>
      <bpmn:outgoing>Flow_9</bpmn:outgoing>
      <bpmn:outgoing>Flow_10</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="End_Matched" name="Nota conciliada">
      <bpmn:incoming>Flow_9</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="Task_Supplement" name="Ordem complementar ou provisão">
      <bpmn:incoming>Flow_10</bpmn:incoming>
      <bpmn:outgoing>Flow_11</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="End_Provisioned" name="Mês fecha com provisão">
      <bpmn:incoming>Flow_11</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="Task_BuildList" name="Montar a lista com ERP, e-mail e WhatsApp">
      <bpmn:incoming>Flow_5</bpmn:incoming>
      <bpmn:outgoing>Flow_12</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_ApproveAll" name="Aprovar tudo, item a item">
      <bpmn:incoming>Flow_12</bpmn:incoming>
      <bpmn:outgoing>Flow_13</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:task id="Task_PayOneByOne" name="Pagar sem esperar a conferência">
      <bpmn:incoming>Flow_13</bpmn:incoming>
      <bpmn:outgoing>Flow_14</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="End_Paid" name="Pago sem mercadoria">
      <bpmn:incoming>Flow_14</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="Start_NeedToBuy" targetRef="Task_IssueOrder" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Task_IssueOrder" targetRef="Task_IssueInvoice" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Task_IssueInvoice" targetRef="Gateway_Split" />
    <bpmn:sequenceFlow id="Flow_4" sourceRef="Gateway_Split" targetRef="Task_Deliver" />
    <bpmn:sequenceFlow id="Flow_5" sourceRef="Gateway_Split" targetRef="Task_BuildList" />
    <bpmn:sequenceFlow id="Flow_6" sourceRef="Task_Deliver" targetRef="Task_Receive" />
    <bpmn:sequenceFlow id="Flow_7" sourceRef="Task_Receive" targetRef="Task_MatchByHand" />
    <bpmn:sequenceFlow id="Flow_8" sourceRef="Task_MatchByHand" targetRef="Gateway_Differs" />
    <bpmn:sequenceFlow id="Flow_9" name="não" sourceRef="Gateway_Differs" targetRef="End_Matched" />
    <bpmn:sequenceFlow id="Flow_10" name="sim" sourceRef="Gateway_Differs" targetRef="Task_Supplement" />
    <bpmn:sequenceFlow id="Flow_11" sourceRef="Task_Supplement" targetRef="End_Provisioned" />
    <bpmn:sequenceFlow id="Flow_12" sourceRef="Task_BuildList" targetRef="Task_ApproveAll" />
    <bpmn:sequenceFlow id="Flow_13" sourceRef="Task_ApproveAll" targetRef="Task_PayOneByOne" />
    <bpmn:sequenceFlow id="Flow_14" sourceRef="Task_PayOneByOne" targetRef="End_Paid" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_AccountsPayable_Current">
    <bpmndi:BPMNPlane id="Plane_AccountsPayable_Current" bpmnElement="Collab_AccountsPayable_Current">
      <bpmndi:BPMNShape id="Part_AccountsPayable_Current_di" bpmnElement="Part_AccountsPayable_Current" isHorizontal="true" color:background-color="#fefefe" color:border-color="#171717">
        <dc:Bounds x="60" y="60" width="1760" height="1200" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Purchasing_di" bpmnElement="Lane_Purchasing" isHorizontal="true" color:background-color="#fffaf3" color:border-color="#a3a3a3">
        <dc:Bounds x="90" y="60" width="1730" height="150" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Supplier_di" bpmnElement="Lane_Supplier" isHorizontal="true" color:background-color="#fbfbfb" color:border-color="#a3a3a3">
        <dc:Bounds x="90" y="210" width="1730" height="150" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Dock_di" bpmnElement="Lane_Dock" isHorizontal="true" color:background-color="#fffaf3" color:border-color="#a3a3a3">
        <dc:Bounds x="90" y="360" width="1730" height="150" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Matching_di" bpmnElement="Lane_Matching" isHorizontal="true" color:background-color="#fffaf3" color:border-color="#a3a3a3">
        <dc:Bounds x="90" y="510" width="1730" height="300" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_DailyList_di" bpmnElement="Lane_DailyList" isHorizontal="true" color:background-color="#fffaf3" color:border-color="#a3a3a3">
        <dc:Bounds x="90" y="810" width="1730" height="150" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_CFO_di" bpmnElement="Lane_CFO" isHorizontal="true" color:background-color="#fffaf3" color:border-color="#a3a3a3">
        <dc:Bounds x="90" y="960" width="1730" height="150" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Bank_di" bpmnElement="Lane_Bank" isHorizontal="true" color:background-color="#f4fbfe" color:border-color="#a3a3a3">
        <dc:Bounds x="90" y="1110" width="1730" height="150" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Start_NeedToBuy_di" bpmnElement="Start_NeedToBuy" color:background-color="#f9f9f9" color:border-color="#737373">
        <dc:Bounds x="185" y="125" width="40" height="40" />
        <bpmndi:BPMNLabel><dc:Bounds x="145" y="171" width="120" height="28" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_IssueOrder_di" bpmnElement="Task_IssueOrder" color:background-color="#fff0db" color:border-color="#e68619">
        <dc:Bounds x="310" y="107" width="130" height="76" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_IssueInvoice_di" bpmnElement="Task_IssueInvoice" color:background-color="#f9f9f9" color:border-color="#737373">
        <dc:Bounds x="480" y="257" width="130" height="76" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_Split_di" bpmnElement="Gateway_Split" color:background-color="#fefefe" color:border-color="#404040">
        <dc:Bounds x="689" y="269" width="52" height="52" />
        <bpmndi:BPMNLabel><dc:Bounds x="721" y="239" width="120" height="28" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Deliver_di" bpmnElement="Task_Deliver" color:background-color="#f9f9f9" color:border-color="#737373">
        <dc:Bounds x="820" y="257" width="130" height="76" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Receive_di" bpmnElement="Task_Receive" color:background-color="#f7e0e0" color:border-color="#c62828">
        <dc:Bounds x="990" y="407" width="130" height="76" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_MatchByHand_di" bpmnElement="Task_MatchByHand" color:background-color="#fff0db" color:border-color="#e68619">
        <dc:Bounds x="1160" y="557" width="130" height="76" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_Differs_di" bpmnElement="Gateway_Differs" color:background-color="#fefefe" color:border-color="#404040">
        <dc:Bounds x="1369" y="569" width="52" height="52" />
        <bpmndi:BPMNLabel><dc:Bounds x="1401" y="539" width="120" height="28" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_Matched_di" bpmnElement="End_Matched" color:background-color="#d2fff1" color:border-color="#12805c">
        <dc:Bounds x="1545" y="575" width="40" height="40" />
        <bpmndi:BPMNLabel><dc:Bounds x="1505" y="621" width="120" height="28" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Supplement_di" bpmnElement="Task_Supplement" color:background-color="#f7e0e0" color:border-color="#c62828">
        <dc:Bounds x="1500" y="707" width="130" height="76" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_Provisioned_di" bpmnElement="End_Provisioned" color:background-color="#f7e0e0" color:border-color="#c62828">
        <dc:Bounds x="1715" y="725" width="40" height="40" />
        <bpmndi:BPMNLabel><dc:Bounds x="1675" y="771" width="120" height="28" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_BuildList_di" bpmnElement="Task_BuildList" color:background-color="#fff0db" color:border-color="#e68619">
        <dc:Bounds x="820" y="857" width="130" height="76" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_ApproveAll_di" bpmnElement="Task_ApproveAll" color:background-color="#fff0db" color:border-color="#e68619">
        <dc:Bounds x="990" y="1007" width="130" height="76" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_PayOneByOne_di" bpmnElement="Task_PayOneByOne" color:background-color="#f7e0e0" color:border-color="#c62828">
        <dc:Bounds x="1160" y="1157" width="130" height="76" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_Paid_di" bpmnElement="End_Paid" color:background-color="#f7e0e0" color:border-color="#c62828">
        <dc:Bounds x="1375" y="1175" width="40" height="40" />
        <bpmndi:BPMNLabel><dc:Bounds x="1335" y="1221" width="120" height="28" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_1_di" bpmnElement="Flow_1" color:border-color="#404040">
        <di:waypoint x="225" y="145" />
        <di:waypoint x="310" y="145" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_2_di" bpmnElement="Flow_2" color:border-color="#404040">
        <di:waypoint x="440" y="145" />
        <di:waypoint x="460" y="145" />
        <di:waypoint x="460" y="295" />
        <di:waypoint x="480" y="295" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_3_di" bpmnElement="Flow_3" color:border-color="#404040">
        <di:waypoint x="610" y="295" />
        <di:waypoint x="689" y="295" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_4_di" bpmnElement="Flow_4" color:border-color="#404040">
        <di:waypoint x="741" y="295" />
        <di:waypoint x="820" y="295" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_5_di" bpmnElement="Flow_5" color:border-color="#404040">
        <di:waypoint x="715" y="321" />
        <di:waypoint x="715" y="895" />
        <di:waypoint x="820" y="895" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_6_di" bpmnElement="Flow_6" color:border-color="#404040">
        <di:waypoint x="950" y="295" />
        <di:waypoint x="970" y="295" />
        <di:waypoint x="970" y="445" />
        <di:waypoint x="990" y="445" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_7_di" bpmnElement="Flow_7" color:border-color="#404040">
        <di:waypoint x="1120" y="445" />
        <di:waypoint x="1140" y="445" />
        <di:waypoint x="1140" y="595" />
        <di:waypoint x="1160" y="595" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_8_di" bpmnElement="Flow_8" color:border-color="#404040">
        <di:waypoint x="1290" y="595" />
        <di:waypoint x="1369" y="595" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_9_di" bpmnElement="Flow_9" color:border-color="#12805c">
