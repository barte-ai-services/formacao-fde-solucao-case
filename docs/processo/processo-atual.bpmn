        <di:waypoint x="1715" y="745" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_12_di" bpmnElement="Flow_12" color:border-color="#404040">
        <di:waypoint x="950" y="895" />
        <di:waypoint x="970" y="895" />
        <di:waypoint x="970" y="1045" />
        <di:waypoint x="990" y="1045" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_13_di" bpmnElement="Flow_13" color:border-color="#404040">
        <di:waypoint x="1120" y="1045" />
        <di:waypoint x="1140" y="1045" />
        <di:waypoint x="1140" y="1195" />
        <di:waypoint x="1160" y="1195" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_14_di" bpmnElement="Flow_14" color:border-color="#c62828">
        <di:waypoint x="1290" y="1195" />
        <di:waypoint x="1375" y="1195" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
