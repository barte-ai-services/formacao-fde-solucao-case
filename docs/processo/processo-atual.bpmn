<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Defs_AccountsPayable_Current" targetNamespace="https://barte.ai/formacao-fde/ja-chegou">
  <bpmn:collaboration id="Collab_AccountsPayable_Current">
    <bpmn:participant id="Part_AccountsPayable_Current" name="Já Chegou: contas a pagar hoje" processRef="AccountsPayable_Current" />
  </bpmn:collaboration>
  <bpmn:process id="AccountsPayable_Current" name="Contas a pagar da Já Chegou: processo atual" isExecutable="false">
    <bpmn:laneSet id="LaneSet_AccountsPayable_Current">
      <bpmn:lane id="Lane_Purchasing" name="Compras">
        <bpmn:flowNodeRef>Start_NeedToBuy</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_IssueOrder</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Supplier" name="Fornecedor">
        <bpmn:flowNodeRef>Task_IssueInvoice</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Deliver</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Dock" name="Doca (CD e lojas)">
        <bpmn:flowNodeRef>Task_Receive</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Matching" name="Contas a pagar: conferência">
        <bpmn:flowNodeRef>Task_MatchByHand</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Differs</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Matched</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Supplement</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Provisioned</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_DailyList" name="Contas a pagar: lista do dia">
        <bpmn:flowNodeRef>Task_BuildList</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_CFO" name="CFO">
        <bpmn:flowNodeRef>Task_ApproveAll</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Bank" name="Banco">
        <bpmn:flowNodeRef>Task_PayOneByOne</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Paid</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_NeedToBuy" name="Precisa comprar">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="Task_IssueOrder" name="Emitir o pedido no ERP">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_IssueInvoice" name="Emitir a nota antes de entregar">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:parallelGateway id="Gateway_Split" name="">
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:task id="Task_Deliver" name="Entregar a mercadoria">
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_Receive" name="Receber a mercadoria">
      <bpmn:incoming>Flow_6</bpmn:incoming>
      <bpmn:outgoing>Flow_7</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_MatchByHand" name="Conferir nota, pedido e recebido à mão">
      <bpmn:incoming>Flow_7</bpmn:incoming>
      <bpmn:outgoing>Flow_8</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_Differs" name="Diverge?">
      <bpmn:incoming>Flow_8</bpmn:incoming>
      <bpmn:outgoing>Flow_9</bpmn:outgoing>
      <bpmn:outgoing>Flow_10</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="End_Matched" name="Nota conciliada">
      <bpmn:incoming>Flow_9</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="Task_Supplement" name="Abrir ordem complementar ou provisionar">
      <bpmn:incoming>Flow_10</bpmn:incoming>
      <bpmn:outgoing>Flow_11</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="End_Provisioned" name="Mês fecha com provisão">
      <bpmn:incoming>Flow_11</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="Task_BuildList" name="Montar a lista do dia (ERP, e-mail, WhatsApp)">
      <bpmn:incoming>Flow_5</bpmn:incoming>
      <bpmn:outgoing>Flow_12</bpmn:outgoing>
    </bpmn:task>
    <bpmn:userTask id="Task_ApproveAll" name="Aprovar item a item, das 16h às 18h">
      <bpmn:incoming>Flow_12</bpmn:incoming>
      <bpmn:outgoing>Flow_13</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:task id="Task_PayOneByOne" name="Pagar um boleto por vez">
      <bpmn:incoming>Flow_13</bpmn:incoming>
      <bpmn:outgoing>Flow_14</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="End_Paid" name="Pago, conferido ou não">
      <bpmn:incoming>Flow_14</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="Start_NeedToBuy" targetRef="Task_IssueOrder" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Task_IssueOrder" targetRef="Task_IssueInvoice" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Task_IssueInvoice" targetRef="Gateway_Split" />
    <bpmn:sequenceFlow id="Flow_4" sourceRef="Gateway_Split" targetRef="Task_Deliver" />
    <bpmn:sequenceFlow id="Flow_5" sourceRef="Gateway_Split" targetRef="Task_BuildList" />
    <bpmn:sequenceFlow id="Flow_6" sourceRef="Task_Deliver" targetRef="Task_Receive" />
    <bpmn:sequenceFlow id="Flow_7" sourceRef="Task_Receive" targetRef="Task_MatchByHand" />
    <bpmn:sequenceFlow id="Flow_8" sourceRef="Task_MatchByHand" targetRef="Gateway_Differs" />
    <bpmn:sequenceFlow id="Flow_9" name="não" sourceRef="Gateway_Differs" targetRef="End_Matched" />
    <bpmn:sequenceFlow id="Flow_10" name="sim" sourceRef="Gateway_Differs" targetRef="Task_Supplement" />
    <bpmn:sequenceFlow id="Flow_11" sourceRef="Task_Supplement" targetRef="End_Provisioned" />
    <bpmn:sequenceFlow id="Flow_12" sourceRef="Task_BuildList" targetRef="Task_ApproveAll" />
    <bpmn:sequenceFlow id="Flow_13" sourceRef="Task_ApproveAll" targetRef="Task_PayOneByOne" />
    <bpmn:sequenceFlow id="Flow_14" sourceRef="Task_PayOneByOne" targetRef="End_Paid" />
    <bpmn:textAnnotation id="Note_1"><bpmn:text>Ninguém olhou a nota antes. Entra mesmo divergente, por pressão comercial.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Assoc_1" sourceRef="Task_Receive" targetRef="Note_1" />
    <bpmn:textAnnotation id="Note_2"><bpmn:text>Até 14 dias no CD. Só 0,7% das notas casam sozinhas.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Assoc_2" sourceRef="Task_MatchByHand" targetRef="Note_2" />
    <bpmn:textAnnotation id="Note_3"><bpmn:text>Pagar errado: R$ 543 mil por mês sem mercadoria, nada recuperado.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Assoc_3" sourceRef="Task_PayOneByOne" targetRef="Note_3" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_AccountsPayable_Current">
    <bpmndi:BPMNPlane id="Plane_AccountsPayable_Current" bpmnElement="Collab_AccountsPayable_Current">
      <bpmndi:BPMNShape id="Part_AccountsPayable_Current_di" bpmnElement="Part_AccountsPayable_Current" isHorizontal="true">
        <dc:Bounds x="100" y="80" width="1670" height="1200" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Purchasing_di" bpmnElement="Lane_Purchasing" isHorizontal="true">
