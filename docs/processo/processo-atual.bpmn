      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Supplement_di" bpmnElement="Task_Supplement">
        <dc:Bounds x="1470" y="745" width="120" height="70" />
      </bpmndi:BPMNShape>
