      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_BuildList_di" bpmnElement="Task_BuildList">
        <dc:Bounds x="830" y="895" width="120" height="70" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_ApproveAll_di" bpmnElement="Task_ApproveAll">
        <dc:Bounds x="990" y="1045" width="120" height="70" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_PayOneByOne_di" bpmnElement="Task_PayOneByOne">
        <dc:Bounds x="1150" y="1195" width="120" height="70" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_Paid_di" bpmnElement="End_Paid">
        <dc:Bounds x="1352" y="1212" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="1320" y="1254" width="100" height="27" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_1_di" bpmnElement="Flow_1">
        <di:waypoint x="268" y="180" />
        <di:waypoint x="350" y="180" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_2_di" bpmnElement="Flow_2">
        <di:waypoint x="470" y="180" />
        <di:waypoint x="492" y="180" />
        <di:waypoint x="492" y="330" />
        <di:waypoint x="510" y="330" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_3_di" bpmnElement="Flow_3">
        <di:waypoint x="630" y="330" />
