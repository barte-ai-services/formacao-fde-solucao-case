        <dc:Bounds x="310" y="107" width="130" height="76" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Classify_di" bpmnElement="Task_Classify" color:background-color="#fdf0f4" color:border-color="#df285d">
        <dc:Bounds x="480" y="257" width="130" height="76" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_Duplicate_di" bpmnElement="Gateway_Duplicate" color:background-color="#fefefe" color:border-color="#404040">
