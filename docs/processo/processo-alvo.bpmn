        <dc:Bounds x="1160" y="257" width="130" height="76" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Approver_di" bpmnElement="Task_Approver" color:background-color="#fdf0f4" color:border-color="#df285d">
        <dc:Bounds x="1330" y="257" width="130" height="76" />
      </bpmndi:BPMNShape>
