<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" id="Defs_AccountsPayable_Target" targetNamespace="https://barte.ai/formacao-fde/ja-chegou">
  <bpmn:collaboration id="Collab_AccountsPayable_Target">
    <bpmn:participant id="Part_AccountsPayable_Target" name="Já Chegou · contas a pagar com o agente" processRef="AccountsPayable_Target" />
  </bpmn:collaboration>
  <bpmn:process id="AccountsPayable_Target" name="Contas a pagar da Já Chegou: processo-alvo" isExecutable="false">
    <bpmn:laneSet id="LaneSet_AccountsPayable_Target">
      <bpmn:lane id="Lane_Capture" name="Captura de notas">
        <bpmn:flowNodeRef>Start_InvoiceIssued</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Capture</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Agent" name="Agente">
        <bpmn:flowNodeRef>Task_Classify</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Duplicate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_BlockDuplicate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_DuplicateBlocked</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_AlreadyPaid</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_LinkPayment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Regularized</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ProposeAction</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Approver</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_WhoDecides</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Reconcile</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Dock" name="Doca (CD)">
        <bpmn:flowNodeRef>Gateway_Join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Plan</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_Arrives</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Count</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_DockDecision</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Approver" name="Aprovador da alçada">
        <bpmn:flowNodeRef>Task_Confirm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ConfirmCount</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Payables" name="Contas a pagar">
        <bpmn:flowNodeRef>Task_ReturnNote</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Block</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Release</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Refused</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_OnList</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_InvoiceIssued" name="Nota emitida na SEFAZ">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:startEvent>
    <bpmn:serviceTask id="Task_Capture" name="Capturar a nota">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_Classify" name="Classificar a divergência">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_Duplicate" name="Duplicada?">
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_BlockDuplicate" name="Bloquear o título duplicado">
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_DuplicateBlocked" name="Título bloqueado">
      <bpmn:incoming>Flow_6</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="Gateway_AlreadyPaid" name="Já paga fora do fluxo?">
      <bpmn:incoming>Flow_5</bpmn:incoming>
      <bpmn:outgoing>Flow_7</bpmn:outgoing>
      <bpmn:outgoing>Flow_8</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_LinkPayment" name="Vincular ao pagamento já feito">
      <bpmn:incoming>Flow_7</bpmn:incoming>
      <bpmn:outgoing>Flow_9</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_Regularized" name="Regularizada, sem novo pagamento">
      <bpmn:incoming>Flow_9</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="Task_ProposeAction" name="Propor a ação na doca">
      <bpmn:incoming>Flow_8</bpmn:incoming>
      <bpmn:outgoing>Flow_10</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:businessRuleTask id="Task_Approver" name="Definir o aprovador pelos limites">
      <bpmn:incoming>Flow_10</bpmn:incoming>
      <bpmn:outgoing>Flow_11</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:exclusiveGateway id="Gateway_WhoDecides" name="Quem decide?">
      <bpmn:incoming>Flow_11</bpmn:incoming>
      <bpmn:outgoing>Flow_12</bpmn:outgoing>
      <bpmn:outgoing>Flow_13</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_Confirm" name="Confirmar ou alterar a ação">
      <bpmn:incoming>Flow_12</bpmn:incoming>
      <bpmn:outgoing>Flow_14</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_Join" name="">
      <bpmn:incoming>Flow_13</bpmn:incoming>
      <bpmn:incoming>Flow_14</bpmn:incoming>
      <bpmn:outgoing>Flow_15</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_Plan" name="Planejar o recebimento">
      <bpmn:incoming>Flow_15</bpmn:incoming>
      <bpmn:outgoing>Flow_16</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:intermediateCatchEvent id="Event_Arrives" name="Mercadoria chega">
      <bpmn:incoming>Flow_16</bpmn:incoming>
      <bpmn:outgoing>Flow_17</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:userTask id="Task_Count" name="Contar a mercadoria">
      <bpmn:incoming>Flow_17</bpmn:incoming>
      <bpmn:outgoing>Flow_18</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="Task_Reconcile" name="Conciliar contagem, nota e pedido">
      <bpmn:incoming>Flow_18</bpmn:incoming>
      <bpmn:outgoing>Flow_19</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="Task_ConfirmCount" name="Confirmar a ação com a contagem">
      <bpmn:incoming>Flow_19</bpmn:incoming>
      <bpmn:outgoing>Flow_20</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_DockDecision" name="Decisão na doca">
      <bpmn:incoming>Flow_20</bpmn:incoming>
      <bpmn:outgoing>Flow_21</bpmn:outgoing>
      <bpmn:outgoing>Flow_22</bpmn:outgoing>
      <bpmn:outgoing>Flow_23</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_ReturnNote" name="Emitir nota de devolução da diferença">
      <bpmn:incoming>Flow_22</bpmn:incoming>
      <bpmn:outgoing>Flow_24</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_Block" name="Bloquear o título">
      <bpmn:incoming>Flow_23</bpmn:incoming>
      <bpmn:outgoing>Flow_26</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_Release" name="Liberar o título para a lista do dia">
      <bpmn:incoming>Flow_21</bpmn:incoming>
      <bpmn:incoming>Flow_24</bpmn:incoming>
      <bpmn:outgoing>Flow_25</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="End_Refused" name="Recusado, título bloqueado">
      <bpmn:incoming>Flow_26</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="End_OnList" name="Na lista do dia, conferido">
      <bpmn:incoming>Flow_25</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="Start_InvoiceIssued" targetRef="Task_Capture" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Task_Capture" targetRef="Task_Classify" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Task_Classify" targetRef="Gateway_Duplicate" />
    <bpmn:sequenceFlow id="Flow_4" name="sim" sourceRef="Gateway_Duplicate" targetRef="Task_BlockDuplicate" />
    <bpmn:sequenceFlow id="Flow_5" name="não" sourceRef="Gateway_Duplicate" targetRef="Gateway_AlreadyPaid" />
    <bpmn:sequenceFlow id="Flow_6" sourceRef="Task_BlockDuplicate" targetRef="End_DuplicateBlocked" />
    <bpmn:sequenceFlow id="Flow_7" name="sim" sourceRef="Gateway_AlreadyPaid" targetRef="Task_LinkPayment" />
    <bpmn:sequenceFlow id="Flow_8" name="não" sourceRef="Gateway_AlreadyPaid" targetRef="Task_ProposeAction" />
    <bpmn:sequenceFlow id="Flow_9" sourceRef="Task_LinkPayment" targetRef="End_Regularized" />
    <bpmn:sequenceFlow id="Flow_10" sourceRef="Task_ProposeAction" targetRef="Task_Approver" />
    <bpmn:sequenceFlow id="Flow_11" sourceRef="Task_Approver" targetRef="Gateway_WhoDecides" />
    <bpmn:sequenceFlow id="Flow_12" name="pessoa" sourceRef="Gateway_WhoDecides" targetRef="Task_Confirm" />
    <bpmn:sequenceFlow id="Flow_13" name="regra" sourceRef="Gateway_WhoDecides" targetRef="Gateway_Join" />
    <bpmn:sequenceFlow id="Flow_14" sourceRef="Task_Confirm" targetRef="Gateway_Join" />
    <bpmn:sequenceFlow id="Flow_15" sourceRef="Gateway_Join" targetRef="Task_Plan" />
    <bpmn:sequenceFlow id="Flow_16" sourceRef="Task_Plan" targetRef="Event_Arrives" />
    <bpmn:sequenceFlow id="Flow_17" sourceRef="Event_Arrives" targetRef="Task_Count" />
    <bpmn:sequenceFlow id="Flow_18" sourceRef="Task_Count" targetRef="Task_Reconcile" />
    <bpmn:sequenceFlow id="Flow_19" sourceRef="Task_Reconcile" targetRef="Task_ConfirmCount" />
    <bpmn:sequenceFlow id="Flow_20" sourceRef="Task_ConfirmCount" targetRef="Gateway_DockDecision" />
    <bpmn:sequenceFlow id="Flow_21" name="receber" sourceRef="Gateway_DockDecision" targetRef="Task_Release" />
    <bpmn:sequenceFlow id="Flow_22" name="receber parcial" sourceRef="Gateway_DockDecision" targetRef="Task_ReturnNote" />
    <bpmn:sequenceFlow id="Flow_23" name="recusar" sourceRef="Gateway_DockDecision" targetRef="Task_Block" />
    <bpmn:sequenceFlow id="Flow_24" sourceRef="Task_ReturnNote" targetRef="Task_Release" />
    <bpmn:sequenceFlow id="Flow_25" sourceRef="Task_Release" targetRef="End_OnList" />
    <bpmn:sequenceFlow id="Flow_26" sourceRef="Task_Block" targetRef="End_Refused" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_AccountsPayable_Target">
    <bpmndi:BPMNPlane id="Plane_AccountsPayable_Target" bpmnElement="Collab_AccountsPayable_Target">
      <bpmndi:BPMNShape id="Part_AccountsPayable_Target_di" bpmnElement="Part_AccountsPayable_Target" isHorizontal="true" color:background-color="#fefefe" color:border-color="#171717">
        <dc:Bounds x="60" y="60" width="3460" height="1200" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Capture_di" bpmnElement="Lane_Capture" isHorizontal="true" color:background-color="#f4fbfe" color:border-color="#a3a3a3">
        <dc:Bounds x="90" y="60" width="3430" height="150" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Agent_di" bpmnElement="Lane_Agent" isHorizontal="true" color:background-color="#fef8fa" color:border-color="#a3a3a3">
