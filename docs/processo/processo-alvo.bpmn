<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Defs_ContasAPagar_Alvo" targetNamespace="https://barte.ai/formacao-fde/ja-chegou">
  <bpmn:collaboration id="Collab_ContasAPagar_Alvo">
    <bpmn:participant id="Part_ContasAPagar_Alvo" name="Já Chegou: contas a pagar com o agente" processRef="ContasAPagar_Alvo" />
  </bpmn:collaboration>
  <bpmn:process id="ContasAPagar_Alvo" name="Contas a pagar da Já Chegou: processo-alvo" isExecutable="false">
    <bpmn:laneSet id="LaneSet_ContasAPagar_Alvo">
      <bpmn:lane id="L_Captura" name="Captura de notas">
        <bpmn:flowNodeRef>B_Emitida</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B_Captura</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_Agente" name="Agente">
        <bpmn:flowNodeRef>B_Classifica</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B_Decide</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B_Alcada</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B_QuemDecide</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B_Concilia</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B_Resultado</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_Aprovador" name="Aprovador da alçada">
        <bpmn:flowNodeRef>B_Aprova</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_Doca" name="Doca (CD)">
        <bpmn:flowNodeRef>B_Junta</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B_Planeja</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B_Chega</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B_Registra</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_ContasPagar" name="Contas a pagar">
        <bpmn:flowNodeRef>B_Libera</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B_Devolucao</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B_Bloqueia</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B_NaLista</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B_Bloqueado</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="B_Emitida" name="Nota emitida na SEFAZ">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:startEvent>
    <bpmn:serviceTask id="B_Captura" name="Capturar a nota">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="B_Classifica" name="Classificar a divergência">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="B_Decide" name="Propor a ação na doca">
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:businessRuleTask id="B_Alcada" name="Definir o aprovador pela régua">
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:exclusiveGateway id="B_QuemDecide" name="Quem decide?">
      <bpmn:incoming>Flow_5</bpmn:incoming>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
      <bpmn:outgoing>Flow_7</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="B_Aprova" name="Confirmar ou alterar a ação">
      <bpmn:incoming>Flow_6</bpmn:incoming>
      <bpmn:outgoing>Flow_8</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="B_Junta" name="">
      <bpmn:incoming>Flow_7</bpmn:incoming>
      <bpmn:incoming>Flow_8</bpmn:incoming>
      <bpmn:outgoing>Flow_9</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="B_Planeja" name="Planejar o recebimento">
      <bpmn:incoming>Flow_9</bpmn:incoming>
      <bpmn:outgoing>Flow_10</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:intermediateCatchEvent id="B_Chega" name="Mercadoria chega">
      <bpmn:incoming>Flow_10</bpmn:incoming>
      <bpmn:outgoing>Flow_11</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:userTask id="B_Registra" name="Registrar o recebido no coletor">
      <bpmn:incoming>Flow_11</bpmn:incoming>
      <bpmn:outgoing>Flow_12</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="B_Concilia" name="Conciliar nota, pedido e recebido">
      <bpmn:incoming>Flow_12</bpmn:incoming>
      <bpmn:outgoing>Flow_13</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="B_Resultado" name="Resultado na doca">
      <bpmn:incoming>Flow_13</bpmn:incoming>
      <bpmn:outgoing>Flow_14</bpmn:outgoing>
      <bpmn:outgoing>Flow_15</bpmn:outgoing>
      <bpmn:outgoing>Flow_16</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="B_Libera" name="Liberar o título para a lista do dia">
      <bpmn:incoming>Flow_14</bpmn:incoming>
      <bpmn:incoming>Flow_17</bpmn:incoming>
      <bpmn:outgoing>Flow_18</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="B_Devolucao" name="Emitir nota de devolução da diferença">
      <bpmn:incoming>Flow_15</bpmn:incoming>
      <bpmn:outgoing>Flow_17</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="B_Bloqueia" name="Bloquear o título">
      <bpmn:incoming>Flow_16</bpmn:incoming>
      <bpmn:outgoing>Flow_19</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="B_NaLista" name="Título na lista do dia, conferido">
      <bpmn:incoming>Flow_18</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="B_Bloqueado" name="Título bloqueado">
      <bpmn:incoming>Flow_19</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="B_Emitida" targetRef="B_Captura" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="B_Captura" targetRef="B_Classifica" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="B_Classifica" targetRef="B_Decide" />
    <bpmn:sequenceFlow id="Flow_4" sourceRef="B_Decide" targetRef="B_Alcada" />
    <bpmn:sequenceFlow id="Flow_5" sourceRef="B_Alcada" targetRef="B_QuemDecide" />
    <bpmn:sequenceFlow id="Flow_6" name="pessoa" sourceRef="B_QuemDecide" targetRef="B_Aprova" />
    <bpmn:sequenceFlow id="Flow_7" name="regra" sourceRef="B_QuemDecide" targetRef="B_Junta" />
    <bpmn:sequenceFlow id="Flow_8" sourceRef="B_Aprova" targetRef="B_Junta" />
    <bpmn:sequenceFlow id="Flow_9" sourceRef="B_Junta" targetRef="B_Planeja" />
    <bpmn:sequenceFlow id="Flow_10" sourceRef="B_Planeja" targetRef="B_Chega" />
    <bpmn:sequenceFlow id="Flow_11" sourceRef="B_Chega" targetRef="B_Registra" />
    <bpmn:sequenceFlow id="Flow_12" sourceRef="B_Registra" targetRef="B_Concilia" />
    <bpmn:sequenceFlow id="Flow_13" sourceRef="B_Concilia" targetRef="B_Resultado" />
    <bpmn:sequenceFlow id="Flow_14" name="receber" sourceRef="B_Resultado" targetRef="B_Libera" />
    <bpmn:sequenceFlow id="Flow_15" name="receber parcial" sourceRef="B_Resultado" targetRef="B_Devolucao" />
    <bpmn:sequenceFlow id="Flow_16" name="recusar" sourceRef="B_Resultado" targetRef="B_Bloqueia" />
    <bpmn:sequenceFlow id="Flow_17" sourceRef="B_Devolucao" targetRef="B_Libera" />
    <bpmn:sequenceFlow id="Flow_18" sourceRef="B_Libera" targetRef="B_NaLista" />
    <bpmn:sequenceFlow id="Flow_19" sourceRef="B_Bloqueia" targetRef="B_Bloqueado" />
    <bpmn:textAnnotation id="Note_1"><bpmn:text>Antes da doca: duplicidade primeiro, depois pedido, pago fora do fluxo, cadastro, item e unidade.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Assoc_1" sourceRef="B_Classifica" targetRef="Note_1" />
    <bpmn:textAnnotation id="Note_2"><bpmn:text>Régua: o que bate passa direto (regra). Exceção vai à alçada; duplicidade é bloqueio.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Assoc_2" sourceRef="B_QuemDecide" targetRef="Note_2" />
    <bpmn:textAnnotation id="Note_3"><bpmn:text>A doca sabe antes do caminhão: receber, receber parcial ou recusar.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Assoc_3" sourceRef="B_Planeja" targetRef="Note_3" />
    <bpmn:textAnnotation id="Note_4"><bpmn:text>Falta física e quantidade menor aparecem aqui.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Assoc_4" sourceRef="B_Concilia" targetRef="Note_4" />
  </bpmn:process>
