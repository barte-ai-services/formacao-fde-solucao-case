      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Payables_di" bpmnElement="Lane_Payables" isHorizontal="true" color:background-color="#fbfbfb" color:border-color="#a3a3a3">
        <dc:Bounds x="90" y="810" width="3430" height="450" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Start_InvoiceIssued_di" bpmnElement="Start_InvoiceIssued" color:background-color="#e1f7ff" color:border-color="#00749e">
        <dc:Bounds x="185" y="125" width="40" height="40" />
        <bpmndi:BPMNLabel><dc:Bounds x="145" y="171" width="120" height="28" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
