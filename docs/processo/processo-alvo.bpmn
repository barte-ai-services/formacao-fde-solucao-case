        <dc:Bounds x="1032" y="1062" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="1000" y="1104" width="100" height="27" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
