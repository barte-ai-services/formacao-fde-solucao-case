        <dc:Bounds x="130" y="230" width="2920" height="150" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Approver_di" bpmnElement="Lane_Approver" isHorizontal="true">
        <dc:Bounds x="130" y="380" width="2920" height="150" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Dock_di" bpmnElement="Lane_Dock" isHorizontal="true">
        <dc:Bounds x="130" y="530" width="2920" height="150" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Payables_di" bpmnElement="Lane_Payables" isHorizontal="true">
        <dc:Bounds x="130" y="680" width="2920" height="450" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Start_InvoiceIssued_di" bpmnElement="Start_InvoiceIssued">
        <dc:Bounds x="232" y="162" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="200" y="204" width="100" height="27" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
