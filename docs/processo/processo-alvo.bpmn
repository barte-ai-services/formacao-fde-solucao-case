        <di:waypoint x="630" y="330" />
        <di:waypoint x="705" y="330" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_4_di" bpmnElement="Flow_4">
        <di:waypoint x="730" y="355" />
        <di:waypoint x="730" y="1080" />
        <di:waypoint x="830" y="1080" />
        <bpmndi:BPMNLabel><dc:Bounds x="736" y="399" width="80" height="18" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_5_di" bpmnElement="Flow_5">
        <di:waypoint x="755" y="330" />
        <di:waypoint x="865" y="330" />
        <bpmndi:BPMNLabel><dc:Bounds x="761" y="308" width="80" height="18" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_6_di" bpmnElement="Flow_6">
        <di:waypoint x="950" y="1080" />
        <di:waypoint x="1032" y="1080" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_7_di" bpmnElement="Flow_7">
        <di:waypoint x="890" y="355" />
        <di:waypoint x="890" y="930" />
        <di:waypoint x="990" y="930" />
        <bpmndi:BPMNLabel><dc:Bounds x="896" y="399" width="80" height="18" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_8_di" bpmnElement="Flow_8">
        <di:waypoint x="915" y="330" />
        <di:waypoint x="990" y="330" />
        <bpmndi:BPMNLabel><dc:Bounds x="921" y="308" width="80" height="18" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_9_di" bpmnElement="Flow_9">
        <di:waypoint x="1110" y="930" />
        <di:waypoint x="1192" y="930" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_10_di" bpmnElement="Flow_10">
        <di:waypoint x="1110" y="330" />
