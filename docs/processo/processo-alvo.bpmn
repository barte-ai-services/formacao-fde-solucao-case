        <dc:Bounds x="3200" y="857" width="130" height="76" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_Refused_di" bpmnElement="End_Refused" color:background-color="#f7e0e0" color:border-color="#c62828">
        <dc:Bounds x="3245" y="1175" width="40" height="40" />
        <bpmndi:BPMNLabel><dc:Bounds x="3205" y="1221" width="120" height="28" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_OnList_di" bpmnElement="End_OnList" color:background-color="#d2fff1" color:border-color="#12805c">
        <dc:Bounds x="3415" y="875" width="40" height="40" />
        <bpmndi:BPMNLabel><dc:Bounds x="3375" y="921" width="120" height="28" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_1_di" bpmnElement="Flow_1" color:border-color="#404040">
        <di:waypoint x="225" y="145" />
        <di:waypoint x="310" y="145" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_2_di" bpmnElement="Flow_2" color:border-color="#404040">
        <di:waypoint x="440" y="145" />
        <di:waypoint x="460" y="145" />
        <di:waypoint x="460" y="295" />
        <di:waypoint x="480" y="295" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_3_di" bpmnElement="Flow_3" color:border-color="#404040">
        <di:waypoint x="610" y="295" />
        <di:waypoint x="689" y="295" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_4_di" bpmnElement="Flow_4" color:border-color="#c62828">
        <di:waypoint x="715" y="321" />
        <di:waypoint x="715" y="407" />
        <bpmndi:BPMNLabel><dc:Bounds x="721" y="329" width="80" height="18" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_5_di" bpmnElement="Flow_5" color:border-color="#404040">
