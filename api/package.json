{
  "name": "formacao-fde-solucao-case-api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "eval:predict": "vitest run --config vitest.eval.config.ts -t predição",
    "eval:score": "vitest run --config vitest.eval.config.ts -t pontuação",
    "eval:description-match": "vitest run --config vitest.eval.config.ts -t 'casamento de descrição'",
    "eval:supplier-request": "vitest run --config vitest.eval.config.ts -t 'e-mail ao fornecedor'"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261031.1",
    "typescript": "6.0.3",
    "vitest": "5.0.5",
    "wrangler": "4.156.0"
  }
}
