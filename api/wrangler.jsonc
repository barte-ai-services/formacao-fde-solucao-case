{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "formacao-fde-solucao-case-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-31",
  "observability": { "enabled": true },
  "triggers": {
    // O Cron roda a cada 15 minutos e, por enquanto, só registra que rodou.
    "crons": ["*/15 * * * *"]
  }
  // Segredos (BARTE_ACADEMY_*) não ficam aqui: em produção, `wrangler secret put`;
  // localmente, no `.dev.vars`, que o git ignora.
}
